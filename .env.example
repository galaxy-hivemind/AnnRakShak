# AnnaRakshak — Environment Configuration Template
# Copy this file to .env and insert your real Gemini API key:
#   cp .env.example .env

# Google Gemini API Key (get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
