# AnnaRakshak — Environment Configuration Template
# Copy this file to .env and insert your real Gemini API key:
#   cp .env.example .env

# Google Gemini API Key (get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Database Configuration:
# - Local Development: Defaults to SQLite at project-local 'annarakshak.db'.
#   Optional custom SQLite path:
#   ANNARAKSHAK_DB_PATH=/path/to/custom_inventory.db
#
# - Vercel Production: Persistent PostgreSQL connection string (e.g. Neon, Supabase, AWS RDS).
#   Required on Vercel deployments (set in Vercel Project Settings -> Environment Variables):
DATABASE_URL=postgresql://username:password@ep-your-database-pooler.region.aws.neon.tech/neondb?sslmode=require

# Image Captures Storage:
# - Local Development: Defaults to project-local 'captures/' directory.
# - Vercel Serverless: Defaults to '/tmp/annarakshak/captures' and auto-cleans up after scan analysis.
# Optional custom directory:
# ANNARAKSHAK_CAPTURES_DIR=/tmp/annarakshak/captures
# Optional cleanup override (true/1 to clean up after scan, false/0 to keep on disk):
# ANNARAKSHAK_CLEANUP_CAPTURES=true
