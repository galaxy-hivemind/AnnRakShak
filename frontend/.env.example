# AnnaRakshak Frontend Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env

# FastAPI Backend URL (default: http://127.0.0.1:8000)
VITE_API_BASE_URL=http://127.0.0.1:8000

# API Mode: 'live' (connects to FastAPI backend) or 'demo' (mock services)
VITE_API_MODE=live
